      "channel_5": "ElevatorDistanceSensor",
      "channel_6": "Not Used",
      "channel_7": "Not Used",
      "channel_8": "Not Used",
      "channel_9": "Not Used",
      "channel_10": "Lights0",
      "channel_11": "Lights1",
      "channel_12": "Lights2",
      "channel_13": "Lights3"
    }
  },

  "rsl": {
